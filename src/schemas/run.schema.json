{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xucheng/openclaw-swarm-layer/schemas/run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "taskId", "attempt", "status", "runner", "workspacePath", "startedAt", "artifacts"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["planned", "accepted", "running", "completed", "failed", "cancelled", "timed_out"] },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "workspacePath": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "promptSummary": { "type": "string" },
    "resultSummary": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "sessionRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "sessionKey": { "type": "string" },
        "backend": { "type": "string" },
        "backendSessionId": { "type": "string" },
        "agentSessionId": { "type": "string" },
        "threadId": { "type": "string" }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "type"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "type": { "type": "string" },
          "detail": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "message"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "upstreamState": { "type": "string" },
        "sessionKey": { "type": "string" },
        "backendSessionId": { "type": "string" }
      }
    },
    "retryHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "runId", "status", "at"],
        "properties": {
          "attempt": { "type": "integer", "minimum": 1 },
          "runId": { "type": "string", "minLength": 1 },
          "status": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "budgetUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exceeded"],
      "properties": {
        "durationSeconds": { "type": "number" },
        "retriesUsed": { "type": "number" },
        "exceeded": { "type": "boolean" },
        "exceededReason": { "type": "string" }
      }
    },
    "lastSignal": { "type": "string" }
  }
}
